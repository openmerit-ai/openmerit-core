{
  "name": "openmerit",
  "version": "0.4.1",
  "description": "Find the right model for your task: Scout reads your task or codebase, binary-searches benchmark-ranked models on your own labelled examples, and picks the winner from Langfuse evaluations.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openmerit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi/extension.d.ts",
      "default": "./dist/pi/extension.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "data/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmerit-ai/openmerit-core.git",
    "directory": "openmerit-core"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-declaration-imports.ts && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "openmerit": "node src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
