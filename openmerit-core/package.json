{
  "name": "openmerit",
  "version": "0.5.3",
  "mcpName": "io.github.openmerit-ai/openmerit",
  "description": "Find the right model for each LLM call in your code, without sitting in your request path. Scout writes an eval from your code and finds cheaper models that pass it. Runs on your machine with your own keys and no OpenMerit account. OpenMerit Cloud at openmerit.ai.",
  "keywords": [
    "llm",
    "model-selection",
    "llm-evaluation",
    "evals",
    "cost-optimization",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "openrouter",
    "cli",
    "self-hosted",
    "local-first"
  ],
  "homepage": "https://openmerit.ai",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openmerit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./ranking": {
      "types": "./dist/ranking/index.d.ts",
      "default": "./dist/ranking/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmerit-ai/openmerit-core.git",
    "directory": "openmerit-core"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build-server.json && node scripts/rewrite-declaration-imports.ts && node ../scripts/build-app.ts --out dist/web && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "OPENMERIT_TELEMETRY=0 node --test --test-concurrency=3 \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "test:server": "node --test --test-concurrency=1 \"test/server/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "openmerit": "node src/cli.ts",
    "server": "node src/server/server.ts",
    "build:catalogue": "node scripts/build-catalogue.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.1",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@rivet-dev/workflows": "1.1.1",
    "ajv": "8.20.0",
    "jiti": "2.7.0",
    "rivetkit": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
