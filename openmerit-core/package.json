{
  "name": "openmerit",
  "version": "0.4.3",
  "description": "Find cheaper models that perform at least as well as the ones your code uses, measured with your own evals: a local CLI and MCP server built on Pi, powered by Claude Code, Codex or an API key.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openmerit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "default": "./dist/sources/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmerit-ai/openmerit-core.git",
    "directory": "openmerit-core"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/rewrite-declaration-imports.ts && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=3 \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:fast": "node --test \"src/**/*.test.ts\" \"test/**/!(daemon).test.ts\"",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "openmerit": "node src/cli.ts",
    "build:catalogue": "node scripts/build-catalogue.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@rivet-dev/workflows": "1.1.1",
    "jiti": "2.7.0",
    "pi-claude-bridge": "0.12.0",
    "rivetkit": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
