{
  // Scout Worker project: its first TypeScript modules and their Node.js tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["scout/**/*.ts", "site/scout/privacy/**/*.ts", "site/scout/scout.ts"],
  // The agent Durable Object needs Workers runtime types: scout/agent/tsconfig.json.
  "exclude": ["scout/agent/agent.ts"]
}
