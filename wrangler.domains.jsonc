{
  "name": "openmerit-domains",
  "account_id": "1f505317550261331711b1274ec53c33",
  "main": "demo/domain-router.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "node --test demo/test/domain-migration.test.mjs && npm run check:docs"
  },
  // The cloud app on Rivet Cloud, which serves /mcp, /.well-known/oauth-protected-resource
  // and /api/*. Empty makes those paths return 503.
  // POSTHOG_*: the website's cookieless $pageview (demo/pageview.ts) goes to the production
  // PostHog project; the token is public. An empty token sends nothing.
  "vars": {
    "CLOUD_APP_ORIGIN": "https://openmeritdr2i.onrivet.dev",
    "POSTHOG_PROJECT_TOKEN": "phc_uGqGVy96bhXQsq59dsx4Wt5N7zSG2zYs3xBT2jqY4KKB",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "services": [
    { "binding": "SCOUT", "service": "openmerit-scout-alpha" },
    { "binding": "SITE", "service": "openmerit-site" }
  ],
  "routes": [
    {
      "pattern": "openmerit.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.openmerit.ai",
      "custom_domain": true
    },
    {
      "pattern": "openmerit.site/*",
      "zone_id": "f4eb6a0586e7778ec5e6fa37bb8fa9e7"
    },
    {
      "pattern": "www.openmerit.site/*",
      "zone_id": "f4eb6a0586e7778ec5e6fa37bb8fa9e7"
    }
  ]
}
