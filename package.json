{
  "name": "openmerit-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm test && npm run check && npm run typecheck && git diff --check"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3"
  }
}
