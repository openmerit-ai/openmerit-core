{
  "name": "openmerit",
  "version": "0.3.7",
  "description": "Evidence-driven model decisions for coding harnesses.",
  "type": "module",
  "bin": {
    "openmerit": "./dist/terminal/src/cli.mjs"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-routing",
    "evaluation"
  ],
  "files": [
    "dist/pi/",
    "dist/terminal/",
    "!dist/terminal/src/*.ts",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./pi": {
      "types": "./dist/pi/src/index.d.ts",
      "default": "./dist/pi/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/pi/src/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laz-aslam/openmerit.git"
  },
  "homepage": "https://github.com/laz-aslam/openmerit#readme",
  "bugs": {
    "url": "https://github.com/laz-aslam/openmerit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*",
    "scout/agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build:site",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scout.json && tsc -p scout/agent/tsconfig.json",
    "check:typescript": "node scripts/check-typescript.ts",
    "types:workers": "node scripts/worker-types.ts",
    "check:worker-types": "node scripts/worker-types.ts --check",
    "deploy": "node scripts/deploy.ts",
    "deploy:status": "node scripts/deploy.ts status",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.ts",
    "check:docs": "npm run build:site && node --test scripts/docs.test.ts",
    "memo": "node demo/memo/preview.ts",
    "check:demo": "npm ci --ignore-scripts --prefix demo && npm run build:site && tsc -p tsconfig.memo.json && node --test demo/test/*.test.mjs demo/test/*.test.ts",
    "prepare": "npm run build",
    "verify": "npm test && npm run check && npm run typecheck && npm run check:typescript && npm run build && npm run check:demo && npm run check:scout && npm run check:docs && npm run build:scout && git diff --check",
    "prepublishOnly": "npm run verify",
    "scout:refresh": "node scout/refresh.mjs",
    "check:scout": "node --test scout/test/*.test.mjs scout/test/*.test.ts && node --check scout/worker.mjs",
    "build:scout": "node scripts/build-scout.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/backend": "3.26.1",
    "@clerk/shared": "4.41.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@lezer/javascript": "1.5.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.18.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "hyparquet": "1.31.5",
    "markdown-it": "15.0.2",
    "miniflare": "5.20260921.0-alpha",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "web-vitals": "6.2.3",
    "wrangler": "4.136.3",
    "yaml": "2.9.1"
  }
}
