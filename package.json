{
  "name": "openmerit",
  "version": "0.1.7",
  "description": "Evidence-driven model decisions for coding harnesses.",
  "type": "module",
  "bin": {
    "openmerit": "./dist/terminal/src/cli.mjs"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-routing",
    "evaluation",
    "pareto-frontier"
  ],
  "files": [
    "dist/core/",
    "dist/protocol/",
    "dist/pi/",
    "dist/terminal/",
    "dist/eval/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "default": "./dist/core/src/index.js"
    },
    "./core": {
      "types": "./dist/core/src/index.d.ts",
      "default": "./dist/core/src/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/src/index.d.ts",
      "default": "./dist/protocol/src/index.js"
    },
    "./pi": {
      "types": "./dist/pi/src/index.d.ts",
      "default": "./dist/pi/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./dist/pi/src/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laz-aslam/openmerit.git"
  },
  "homepage": "https://github.com/laz-aslam/openmerit#readme",
  "bugs": {
    "url": "https://github.com/laz-aslam/openmerit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "predash": "node scripts/build-terminal.mjs",
    "dash": "node packages/terminal/src/cli.mjs dash",
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs": "npm run build:docs && node --test scripts/docs.test.mjs",
    "check:demo": "node --test demo/test/*.test.mjs",
    "prepare": "npm run build",
    "verify": "npm test && npm run check && npm run typecheck && npm run build && npm run check:demo && npm run check:scout && npm run check:docs && npm run build:scout && git diff --check",
    "prepublishOnly": "npm run verify",
    "build:dash-preview": "node scripts/build-terminal-preview.mjs",
    "deploy:dash-preview": "npx --yes wrangler@4.136.3 deploy --config wrangler.terminal.jsonc",
    "scout": "node scout/dev.mjs",
    "scout:refresh": "node scout/refresh.mjs",
    "check:scout": "node --test scout/test/*.test.mjs && node --check scout/worker.mjs && node --check site/scout/scout.js",
    "build:scout": "node scripts/build-scout.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@iarna/toml": "2.2.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/python": "1.1.19",
    "hyparquet": "1.31.5",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0 <0.88.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/backend": "3.26.1",
    "@clerk/shared": "4.41.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.18.6",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "liveline": "0.0.7",
    "markdown-it": "15.0.2",
    "minisearch": "7.2.0",
    "morphdom": "2.7.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "torph": "0.1.3",
    "typescript": "^5.9.3",
    "web-vitals": "6.2.3"
  }
}
