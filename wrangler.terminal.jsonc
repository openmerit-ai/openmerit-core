{
  "name": "openmerit-terminal-preview",
  "account_id": "1f505317550261331711b1274ec53c33",
  "main": "packages/terminal/hosted/worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:dash-preview && npm run check:docs && npm run check --workspace @openmerit/terminal && npm test --workspace @openmerit/terminal"
  },
  "routes": [
    {
      "pattern": "dash.openmerit.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/terminal-preview",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
