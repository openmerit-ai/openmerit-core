{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmerit-scout-alpha",
  "account_id": "1f505317550261331711b1274ec53c33",
  // The web Worker: the landing page, the playground walkthrough, the content
  // pages and the contact-sales form; /scout redirects to /contact-sales/. It
  // keeps the former Scout Worker's identity.
  "main": "demo/web.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "openmerit.ai/scout*", "zone_id": "4192d54a67b16e3af7e1503a7590dc65" }
  ],
  "assets": {
    "directory": "./dist/scout-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "migrations": [
    { "tag": "accounts-1", "new_sqlite_classes": ["ScoutAccounts"] },
    { "tag": "agent-1", "new_sqlite_classes": ["ScoutAgent"] },
    { "tag": "evaluations-1", "new_sqlite_classes": ["ScoutEvaluations"] },
    // Deploying this deletes the retired Scout account, agent and evaluation
    // Durable Objects and all of their stored data.
    { "tag": "remove-scout-1", "deleted_classes": ["ScoutAccounts", "ScoutAgent", "ScoutEvaluations"] }
  ],
  // The contact-sales form emails each request to CONTACT_TO, sent from the
  // address the memo already verified, and allows 3 submissions a minute per IP.
  "vars": {
    "CONTACT_TO": "team@openmerit.ai",
    "CONTACT_FROM": "memo@openmerit.ai"
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "allowed_sender_addresses": ["memo@openmerit.ai"], "allowed_destination_addresses": ["team@openmerit.ai"] }],
  "ratelimits": [{ "name": "CONTACT_RATE", "namespace_id": "2026112601", "simple": { "limit": 3, "period": 60 } }],
  "build": {
    "command": "npm run check:web && npm run check:docs && npm run build:scout"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
