{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmerit-scout-alpha",
  "account_id": "1f505317550261331711b1274ec53c33",
  "main": "scout/alpha-worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  // Keep the existing fetch-only Worker identity and secrets.
  // Canonical Scout now overrides the router's older serving implementation;
  // adjacent paths such as /scouting still pass through to the Custom Domain.
  "routes": [
    { "pattern": "openmerit.ai/scout*", "zone_id": "4192d54a67b16e3af7e1503a7590dc65" },
    // Product-level coding-agent device sign-in (/connect and /connect/api/*).
    { "pattern": "openmerit.ai/connect*", "zone_id": "4192d54a67b16e3af7e1503a7590dc65" }
  ],
  "assets": {
    "directory": "./dist/scout-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Read the published production catalogue; no indexing cron or Workflow.
  "r2_buckets": [{ "binding": "SCOUT_CATALOGUE", "bucket_name": "openmerit-scout-catalogue" }],
  "d1_databases": [{ "binding": "SCOUT_INDEX", "database_name": "openmerit-scout-index", "database_id": "80312d1c-c9e7-43f3-a09d-cb4b2c538f49" }],
  "vectorize": [{ "binding": "SCOUT_EVIDENCE", "index_name": "openmerit-scout-evidence" }],
  // Historical Analytics Engine records are untouched; new search events go to PostHog.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "SCOUT_ACCOUNTS", "class_name": "ScoutAccounts" }] },
  "migrations": [{ "tag": "accounts-1", "new_sqlite_classes": ["ScoutAccounts"] }],
  // Product analytics remain off without POSTHOG_PROJECT_TOKEN and POSTHOG_HOST.
  "vars": { "POSTHOG_ENVIRONMENT": "production", "POSTHOG_PROJECT_ID": "315509", "POSTHOG_CAPTURE_CONTENT": "true", "SCOUT_BETA_EVALUATION_LOGGING": "true" },
  "ratelimits": [{ "name": "SCOUT_RATE", "namespace_id": "2026102101", "simple": { "limit": 60, "period": 60 } }],
  "build": {
    "command": "npm run check:scout && npm run check:docs && npm run build:scout"
  },
  // Persist sanitized delivery counters, not request URLs/device approval codes.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
