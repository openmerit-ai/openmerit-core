{
  "$schema": "node_modules/wrangler/config-schema.json",
  // app.openmerit.ai: the cloud plan's run and account pages, built from app/ by
  // scripts/build-app.ts and served by app/worker.ts. The pages sign in with
  // Clerk and fetch their data from the cloud app's /api/* at API_ORIGIN; the
  // Worker holds no data and no secrets.
  "name": "openmerit-app",
  "account_id": "1f505317550261331711b1274ec53c33",
  "main": "app/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.openmerit.ai", "custom_domain": true }
  ],
  "vars": {
    // The domain router sends openmerit.ai/api/* to the cloud app, which allows
    // this origin by CORS.
    "API_ORIGIN": "https://openmerit.ai",
    // Public: the same key ClerkJS reads in every signed-in page.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsub3Blbm1lcml0LmFpJA",
    // Public: the production PostHog project's token, which /ingest/e/ adds to the
    // pages' events. `npm run app` uses the environment's token or none instead.
    "POSTHOG_PROJECT_TOKEN": "phc_uGqGVy96bhXQsq59dsx4Wt5N7zSG2zYs3xBT2jqY4KKB",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "assets": {
    "directory": "./dist/app",
    "binding": "ASSETS",
    // The Worker serves /config.json and the shared report page at /r/<id>/.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "node --test app/test/*.test.ts && node scripts/build-app.ts"
  }
}
