{
  "name": "openmerit-cloud",
  "private": true,
  "description": "Deploys the OpenMerit server (openmerit-core/src/server) to openmerit.ai, on a Rivet Cloud hosted actor node.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node ../openmerit-core/src/server/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck",
    "deploy": "node scripts/deploy.ts"
  },
  "devDependencies": {
    "@rivetkit/cli": "3.1.1",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
