{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmerit-site",
  "main": "demo/worker.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build && npm ci --ignore-scripts --prefix demo && npm run check:demo && npm run check:docs"
  },
  "routes": [
    {
      "pattern": "openmerit.site/*",
      "zone_id": "f4eb6a0586e7778ec5e6fa37bb8fa9e7"
    },
    {
      "pattern": "www.openmerit.site/*",
      "zone_id": "f4eb6a0586e7778ec5e6fa37bb8fa9e7"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/demo/api/*",
      "/demo/internal/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "DEMO_ENABLED": "false",
    "DEMO_BUILD": "demo-20260928-fieldkit-v1"
  },
  "containers": [
    {
      "class_name": "DemoContainer",
      "image": "./demo/Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_CONTAINER",
        "class_name": "DemoContainer"
      },
      {
        "name": "DEMO_GATE",
        "class_name": "DemoGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "demo-v1",
      "new_sqlite_classes": [
        "DemoContainer",
        "DemoGate"
      ]
    }
  ]
}
