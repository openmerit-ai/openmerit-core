{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmerit-site",
  "main": "demo/site.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build && npm ci --ignore-scripts --prefix demo && npm run check:demo && npm run check:docs"
  },
  // Public domains are owned by wrangler.domains.jsonc.
  // This is a code-only restoration. Never upload the older local site tree.
  // The deploy wrapper remains the release gate.
  "routes": [],
  // Wrangler 4.136.3 has no keep-assets flag. These documented multipart
  // metadata fields retain the prior uploaded bundle and its exact routing.
  "unsafe": {
    "bindings": [{ "name": "ASSETS", "type": "assets" }],
    "metadata": {
      "keep_assets": true,
      "assets": {
        "config": {
          "html_handling": "auto-trailing-slash",
          "not_found_handling": "404-page",
          "run_worker_first": ["/memo", "/memo/*"],
          "base_path": "/"
        }
      }
    }
  },
  "vars": {
    "MEMO_AUTH_ORIGIN": "https://openmerit.ai",
    "MEMO_ADMIN_EMAILS": "code@lazim.one",
    "MEMO_EMAIL_PROVIDER": "cloudflare",
    "MEMO_EMAIL_FROM": "OpenMerit <memo@openmerit.ai>",
    "MEMO_DAILY_EMAIL_LIMIT": "100"
  },
  "send_email": [{ "name": "MEMO_EMAIL", "allowed_sender_addresses": ["memo@openmerit.ai"] }],
  "d1_databases": [{
    "binding": "MEMO_DB",
    "database_name": "openmerit-memo",
    "database_id": "56c8be4f-551c-4b6d-bc23-8f22058115f6",
    "migrations_dir": "demo/memo/migrations"
  }],
  "migrations": [
    {
      "tag": "demo-v1",
      "new_sqlite_classes": [
        "DemoContainer",
        "DemoGate"
      ]
    },
    {
      "tag": "live-demo-v1",
      "new_sqlite_classes": ["LiveBroadcast"]
    },
    {
      "tag": "remove-live-demo-v1",
      "deleted_classes": ["LiveBroadcast"]
    },
    {
      "tag": "remove-demo-v1",
      "deleted_classes": ["DemoContainer", "DemoGate"]
    }
  ]
}
