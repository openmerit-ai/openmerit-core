#!/usr/bin/env bash
# Prepares an Amp orb: installs the Node.js version CI uses and the npm dependencies of the
# website (root), the openmerit package (openmerit-core/), the Sahra Health playground and the cloud app (cloud/),
# and Docker's buildx plugin for the cloud app's deploy.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# Keep in sync with node-version in .github/workflows/ci.yml.
NODE_VERSION=22.19.0
node_dist="node-v${NODE_VERSION}-linux-x64"
node_home="$HOME/.local/share/node/$node_dist"
bin_dir="$HOME/.local/bin" # Already on PATH for Amp commands, login shells, and services.

install_node() {
  if [[ ! -x "$node_home/bin/node" ]]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${node_dist}.tar.xz" -o "$tmp/$node_dist.tar.xz"
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
    (cd "$tmp" && grep " $node_dist.tar.xz\$" SHASUMS256.txt | sha256sum -c -)
    mkdir -p "$(dirname "$node_home")"
    tar -xJf "$tmp/$node_dist.tar.xz" -C "$(dirname "$node_home")"
    rm -rf "$tmp"
  fi
  mkdir -p "$bin_dir"
  for tool in node npm npx corepack; do
    ln -sfn "$node_home/bin/$tool" "$bin_dir/$tool"
  done
}

step "Node.js $NODE_VERSION" install_node
export PATH="$bin_dir:$PATH"
node --version

# The cloud app's deploy (cloud/scripts/deploy.ts) builds its image with `docker buildx`. The orb
# image has Docker's engine and apt repository but not the buildx plugin. The daemon cannot run
# from setup, so it is started when needed (see AGENTS.md).
install_docker_buildx() {
  local packages=()
  command -v dockerd > /dev/null || packages+=(docker-ce docker-ce-cli containerd.io)
  docker buildx version > /dev/null 2>&1 || packages+=(docker-buildx-plugin)
  if ((${#packages[@]})); then
    sudo apt-get update -q
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q "${packages[@]}"
  else
    echo "Docker and buildx already installed"
  fi
}
step "Docker and buildx" install_docker_buildx

# npm reads the NPM_TOKEN project secret at run time; the snapshot stores only this reference.
npm_auth='//registry.npmjs.org/:_authToken=${NPM_TOKEN}'
grep -Fqx "$npm_auth" "$HOME/.npmrc" 2>/dev/null || echo "$npm_auth" >> "$HOME/.npmrc"

# npm ci always deletes node_modules, so a stale snapshot would reinstall everything.
# Skip it when the manifest, lockfile and Node.js version match the last install;
# the marker lives inside node_modules so it disappears with it.
install_deps() {
  local dir="$1"
  local marker="$dir/node_modules/.orb-setup-fingerprint"
  local fingerprint
  fingerprint="$(
    {
      node --version
      cat "$dir/package-lock.json" "$dir/package.json"
    } | sha256sum | cut -d' ' -f1
  )"
  if [[ -d "$dir/node_modules" && "$(cat "$marker" 2>/dev/null)" == "$fingerprint" ]]; then
    echo "npm dependencies in $dir unchanged"
  else
    step "npm ci in $dir" npm ci --prefix "$dir" --prefer-offline --no-audit --no-fund
    echo "$fingerprint" > "$marker"
  fi
}

# demo/ is left out: npm run check:demo installs it on every run.
for dir in . openmerit-core playground cloud; do
  install_deps "$dir"
done
