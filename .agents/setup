#!/usr/bin/env bash
# Prepares an Amp orb: installs the Node.js version CI uses and the npm dependencies.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# Keep in sync with node-version in .github/workflows/ci.yml. The orb's default
# Node.js is newer and fails the terminal worker tests.
NODE_VERSION=22.19.0
node_dist="node-v${NODE_VERSION}-linux-x64"
node_home="$HOME/.local/share/node/$node_dist"
bin_dir="$HOME/.local/bin" # Already on PATH for Amp commands, login shells, and services.

install_node() {
  if [[ ! -x "$node_home/bin/node" ]]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${node_dist}.tar.xz" -o "$tmp/$node_dist.tar.xz"
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
    (cd "$tmp" && grep " $node_dist.tar.xz\$" SHASUMS256.txt | sha256sum -c -)
    mkdir -p "$(dirname "$node_home")"
    tar -xJf "$tmp/$node_dist.tar.xz" -C "$(dirname "$node_home")"
    rm -rf "$tmp"
  fi
  mkdir -p "$bin_dir"
  for tool in node npm npx corepack; do
    ln -sfn "$node_home/bin/$tool" "$bin_dir/$tool"
  done
}

step "Node.js $NODE_VERSION" install_node
export PATH="$bin_dir:$PATH"
node --version

# npm reads the NPM_TOKEN project secret at run time; the snapshot stores only this reference.
npm_auth='//registry.npmjs.org/:_authToken=${NPM_TOKEN}'
grep -Fqx "$npm_auth" "$HOME/.npmrc" 2>/dev/null || echo "$npm_auth" >> "$HOME/.npmrc"

# npm ci always deletes node_modules, so a stale snapshot would reinstall everything.
# Skip it when the manifests, lockfile and Node.js version match the last install;
# the marker lives inside node_modules so it disappears with it.
deps_marker=node_modules/.orb-setup-fingerprint
deps_fingerprint="$(
  {
    node --version
    cat package-lock.json package.json packages/*/package.json
  } | sha256sum | cut -d' ' -f1
)"
if [[ -d node_modules && "$(cat "$deps_marker" 2>/dev/null)" == "$deps_fingerprint" ]]; then
  # The checkout may be newer than the snapshot; rebuild dist/ as npm ci's prepare would.
  step "npm run build (dependencies unchanged)" npm run build
else
  # npm ci also runs the prepare script, which builds dist/.
  step "npm ci" npm ci --prefer-offline --no-audit --no-fund
  echo "$deps_fingerprint" > "$deps_marker"
fi
